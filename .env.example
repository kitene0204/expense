# GEMINI_API_KEY: Required for Gemini AI API calls on backend (if using server.ts)
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# VITE_GEMINI_API_KEY: Required if deploying as a pure frontend static client-side SPA (Vercel Method B)
# If you build and deploy to Vercel/Netlify as a static site, set this in your deployment platform's Environment Variables.
VITE_GEMINI_API_KEY=
